<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:background="@drawable/bg_header_gradient"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="18dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <!-- BARU: avatar + teks rata tengah vertikal (dulu horizontal kiri) -->
    <TextView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:text="A"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/drawer_title"
        android:textColor="@color/white"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/drawer_subtitle"
        android:textColor="#E0FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_badge"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="✦ v2.0  •  Java  •  Indigo–Violet"
        android:textColor="@color/primary_dark"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
